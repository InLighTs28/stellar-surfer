# Debut de la Distance infinie (en tant que le Surfer)
scoreboard players set @s stlboy.inf 80
scoreboard players set @s stlboy.infcd 700
effect give @s minecraft:hunger 3 2 true
playsound minecraft:block.beacon.power_select player @a ~ ~ ~ 0.8 1.8
playsound minecraft:entity.illusioner.cast_spell player @a ~ ~ ~ 0.6 0.6
title @s actionbar {"translate":"stlboy.infinity.on","fallback":"✦ Infinite Distance ✦","color":"#9FC8FF"}
