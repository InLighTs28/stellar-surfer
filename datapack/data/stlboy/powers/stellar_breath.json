 "flight_lock": {
  "type": "apoli:action_over_time",
  "interval": 1,
  "condition": {
   "type": "apoli:and",
   "conditions": [
    {
     "type": "apoli:resource",
     "resource": "stlboy:stellar_breath_idle",
     "comparison": "<",
     "compare_to": 4
    },
    {
     "type": "apoli:resource",
     "resource": "stlboy:flight_armed",
     "comparison": "==",
     "compare_to": 1
    }
   ]
  },
  "entity_action": {
   "type": "apoli:and",
   "actions": [
    {
     "type": "apoli:if_else",
     "condition": {
      "type": "apoli:resource",
      "resource": "stlboy:stellar_breath_locked",
      "comparison": "==",
      "compare_to": 0
     },
     "if_action": {
      "type": "apoli:and",
      "actions": [
       {
        "type": "apoli:and",
        "actions": [
         {
          "type": "apoli:execute_command",
          "command": "scoreboard players operation #own stlboy.tmp = @s stlboy.sid"
         },
         {
          "type": "apoli:execute_command",
          "command": "function stlboy:breath/lock_new"
         }
        ]
       },
       {
        "type": "apoli:change_resource",
        "resource": "stlboy:stellar_breath_locked",
        "change": 1,
        "operation": "set"
       }
      ]
     }
    },
    {
     "type": "apoli:add_velocity",
     "space": "world",
     "set": true,
     "x": "resource(stlboy:flight_vx) / 1000 * (1 - 0.5 * resource(stlboy:stellar_breath_firing))",
     "y": "resource(stlboy:flight_vy) / 1000 * (1 - 0.5 * resource(stlboy:stellar_breath_firing))",
     "z": "resource(stlboy:flight_vz) / 1000 * (1 - 0.5 * resource(stlboy:stellar_breath_firing))"
    }
   ]
  }
 },
