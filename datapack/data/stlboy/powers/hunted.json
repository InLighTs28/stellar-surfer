         "command": "particle apoli:custom{texture:\"stlboy:textures/particle/wisp.png\",lifetime:20,lifetime_variation:5,size:0.2f,size_variation:0.06f,end_size:0.0f,color:\"#3FE8D8DD\",end_color:\"#1A4A8A00\",friction:0.92f,gravity:-0.004f,physics:false,emissive:true,blend:\"translucent\",easing:\"ease_out_quad\",roll:\"rUni(0, 360)\",roll_speed:\"rNor(0, 3)\"} ~ ~1.0 ~ 0.4 0.6 0.4 0 15"
        },
