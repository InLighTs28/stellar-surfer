{
 "type": "apoli:multiple",
 "name": "Hunted",
 "description": "§7§oStrike a star and all of creation turns its gaze upon it. Wounded, your glow betrays you: the world closes in, and every shaft loosed your way finds its path to your §c§oheart§7§o.",
 "badges": [
  {
   "type": "origins:tooltip",
   "sprite": "stlboy:textures/gui/badge/weak.png",
   "text": "§7A hit from a mob or player §cmay drag you down§7: §f100%§7 chance at Rank 0, §f-8.5%§7 per Rank, never below §f15%§7."
  },
  {
   "type": "origins:tooltip",
   "sprite": "stlboy:textures/gui/badge/gauge.png",
   "text": "§cHunted§7 for §f3s§7 by mobs, §f8s§7 by players."
  },
  {
   "type": "origins:tooltip",
   "sprite": "stlboy:textures/gui/badge/weak.png",
   "text": "§cWhile Hunted:§7 movement §c÷2§7, no flight or surges, and you §eglow§7."
  },
  {
   "type": "origins:tooltip",
   "sprite": "stlboy:textures/gui/badge/orbit.png",
   "text": "§cWhile Hunted:§7 projectiles within §f5 blocks§7 are §cpulled into you§7."
  }
 ],
