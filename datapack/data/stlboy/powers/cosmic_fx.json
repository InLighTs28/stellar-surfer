 "magnet_on": {
  "type": "apoli:resource",
  "min": 0,
  "max": 1,
  "start_value": 1,
  "hud_render": {
   "should_render": false
  }
 },
 "magnet_toggle": {
  "type": "apoli:action_on_key_press",
  "cooldown": 8,
  "key": {
   "key": "key.playerlist"
  },
  "entity_action": {
   "type": "apoli:if_else",
   "condition": {
    "type": "apoli:resource",
    "resource": "stlboy:cosmic_fx_magnet_on",
    "comparison": "==",
    "compare_to": 1
   },
   "if_action": {
    "type": "apoli:and",
    "actions": [
     {
      "type": "apoli:change_resource",
      "resource": "stlboy:cosmic_fx_magnet_on",
      "change": 0,
      "operation": "set"
     },
     {
      "type": "apoli:execute_command",
      "command": "title @s actionbar {\"text\":\"✦ Item magnet: OFF ✦\",\"color\":\"gray\"}"
     },
     {
      "type": "apoli:execute_command",
      "command": "playsound stlboy:cosmic.off player @s ~ ~ ~ 0.4 1.6"
     }
    ]
   },
   "else_action": {
    "type": "apoli:and",
    "actions": [
     {
      "type": "apoli:change_resource",
      "resource": "stlboy:cosmic_fx_magnet_on",
      "change": 1,
      "operation": "set"
     },
     {
      "type": "apoli:execute_command",
      "command": "title @s actionbar {\"text\":\"✦ Item magnet: ON ✦\",\"color\":\"aqua\"}"
     },
     {
      "type": "apoli:execute_command",
      "command": "playsound stlboy:cosmic.on player @s ~ ~ ~ 0.4 1.8"
     }
    ]
   }
  },
  "condition": {
   "type": "apoli:command",
   "command": "execute if entity @s[tag=stlboy_sk_mag]",
   "comparison": ">=",
   "compare_to": 1
  }
 },
