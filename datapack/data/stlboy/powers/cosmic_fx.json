{
 "type": "apoli:multiple",
 "hidden": true,
 "name": "Cosmic FX",
 "description": "Visual summons of the Stellar Surfer.",
 "sn_flag": {
  "type": "apoli:resource",
  "min": 0,
  "max": 1,
  "start_value": 0,
  "hud_render": {
   "should_render": false
  }
 },
 "sn_summon": {
  "type": "apoli:action_over_time",
  "interval": 1,
  "condition": {
   "type": "apoli:resource",
   "resource": "stlboy:cosmic_fx_sn_flag",
   "comparison": "==",
   "compare_to": 1
  },
  "entity_action": {
   "type": "apoli:and",
   "actions": [
    {
     "type": "apoli:change_resource",
     "resource": "stlboy:cosmic_fx_sn_flag",
     "change": 0,
     "operation": "set"
    },
    {
     "type": "apoli:summon_minion",
     "follow_owner": false,
     "scale": 1.0,
     "invulnerable": true,
     "max_life_ticks": 1200,
     "summon_id": "stlboy:sn",
     "powers": [
      "stlboy:orb_sn"
     ],
     "offset": {
      "x": 0,
      "y": 0,
      "z": 0
     },
     "space": "local",
     "bientity_action": {
      "type": "apoli:target_action",
      "action": {
       "type": "apoli:and",
       "actions": [
        {
         "type": "apoli:execute_command",
         "command": "tag @s add stlboy_orb"
        },
        {
         "type": "apoli:execute_command",
         "command": "tag @s add stlboy_vsn"
        },
        {
         "type": "apoli:execute_command",
         "command": "effect give @s minecraft:invisibility infinite 0 true"
        },
        {
         "type": "apoli:execute_command",
         "command": "data merge entity @s {NoGravity:1b,Silent:1b}"
        },
        {
         "type": "apoli:execute_command",
         "command": "attribute @s minecraft:generic.gravity base set 0"
        },
        {
         "type": "apoli:execute_command",
         "command": "execute at @e[type=minecraft:marker,tag=stlboy_sn,limit=1,predicate=stlboy:owned] run tp @s ~ ~-0.6 ~"
        }
       ]
      }
     }
    }
   ]
  }
 },
 "wheel_up": {
  "type": "apoli:action_on_scroll_wheel",
  "direction": "up",
  "prevent_hotbar_change": true,
  "condition": {
   "type": "apoli:or",
   "conditions": [
    {
     "type": "apoli:resource",
     "resource": "stlboy:graviton_mode",
     "comparison": "==",
     "compare_to": 2
    },
    {
     "type": "apoli:resource",
     "resource": "stlboy:graviton_nmode",
     "comparison": "==",
     "compare_to": 1
    }
   ]
  },
  "entity_action": {
   "type": "apoli:and",
   "actions": [
    {
     "type": "apoli:execute_command",
     "command": "scoreboard players operation #own stlboy.tmp = @s stlboy.sid"
    },
    {
     "type": "apoli:execute_command",
     "command": "function stlboy:orb/wheel_up"
    }
   ]
  }
 },
 "wheel_down": {
  "type": "apoli:action_on_scroll_wheel",
  "direction": "down",
  "prevent_hotbar_change": true,
  "condition": {
   "type": "apoli:or",
   "conditions": [
    {
     "type": "apoli:resource",
     "resource": "stlboy:graviton_mode",
     "comparison": "==",
     "compare_to": 2
    },
    {
     "type": "apoli:resource",
     "resource": "stlboy:graviton_nmode",
     "comparison": "==",
     "compare_to": 1
    }
   ]
  },
  "entity_action": {
   "type": "apoli:and",
   "actions": [
    {
     "type": "apoli:execute_command",
     "command": "scoreboard players operation #own stlboy.tmp = @s stlboy.sid"
    },
    {
     "type": "apoli:execute_command",
     "command": "function stlboy:orb/wheel_down"
    }
   ]
  }
 },
 "sky_start": {
  "type": "apoli:action_on_callback",
  "entity_action_gained": {
   "type": "apoli:if_else",
   "condition": {
    "type": "apoli:dimension",
    "dimension": "minecraft:overworld"
   },
   "if_action": {
    "type": "apoli:and",
    "actions": [
     {
      "type": "apoli:execute_command",
      "command": "execute at @s positioned over motion_blocking_no_leaves run tp @s ~ ~20 ~"
     },
     {
      "type": "apoli:execute_command",
      "command": "effect give @s minecraft:slow_falling 10 0 true"
     },
     {
      "type": "apoli:execute_command",
      "command": "title @s actionbar {\"text\":\"✦ Born from the stars ✦\",\"color\":\"light_purple\"}"
     }
    ]
   }
  }
 },
 "magnet": {
  "type": "apoli:action_over_time",
  "interval": 1,
  "entity_action": {
   "type": "apoli:and",
   "actions": [
    {
     "type": "apoli:execute_command",
     "command": "scoreboard players operation #own stlboy.tmp = @s stlboy.sid"
    },
    {
     "type": "apoli:execute_command",
     "command": "function stlboy:magnet/tick"
    }
   ]
  },
  "condition": {
   "type": "apoli:and",
   "conditions": [
    {
     "type": "apoli:resource",
     "resource": "stlboy:cosmic_fx_magnet_on",
     "comparison": "==",
     "compare_to": 1
    },
    {
     "type": "apoli:command",
     "command": "execute if entity @s[tag=stlboy_sk_mag]",
     "comparison": ">=",
     "compare_to": 1
    }
   ]
  }
 },
